# Keep nested vendor inside plugin-update-checker (for Parsedown, etc.)
!vendor/plugin-update-checker/vendor/
!vendor/plugin-update-checker/vendor/**

# Keep plugin-update-checker-master if user added it (alternative location)
!plugin-update-checker-master/
!plugin-update-checker-master/**

